# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# ZEGOCLOUD_APP_ID: App ID from ZEGOCLOUD Console for real-time voice & video calling
ZEGOCLOUD_APP_ID=123456789

# ZEGOCLOUD_APP_SIGN: App Sign from ZEGOCLOUD Console (64 hex characters)
ZEGOCLOUD_APP_SIGN=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789
